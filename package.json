{
  "name": "terra-map-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A modular TypeScript toolkit for CesiumJS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeyongzhi/TerraMapKit.git"
  },
  "homepage": "https://github.com/yeyongzhi/TerraMapKit#readme",
  "bugs": {
    "url": "https://github.com/yeyongzhi/TerraMapKit/issues"
  },
  "keywords": [
    "cesium",
    "gis",
    "map",
    "typescript",
    "effects"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./layer": {
      "types": "./dist/layer/index.d.ts",
      "import": "./dist/layer/index.js"
    },
    "./mask": {
      "types": "./dist/mask/index.d.ts",
      "import": "./dist/mask/index.js"
    },
    "./coordinate": {
      "types": "./dist/coordinate/index.d.ts",
      "import": "./dist/coordinate/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js"
    },
    "./pick": {
      "types": "./dist/pick/index.d.ts",
      "import": "./dist/pick/index.js"
    },
    "./draw": {
      "types": "./dist/draw/index.d.ts",
      "import": "./dist/draw/index.js"
    },
    "./camera": {
      "types": "./dist/camera/index.d.ts",
      "import": "./dist/camera/index.js"
    },
    "./popup": {
      "types": "./dist/popup/index.d.ts",
      "import": "./dist/popup/index.js"
    },
    "./measure": {
      "types": "./dist/measure/index.d.ts",
      "import": "./dist/measure/index.js"
    },
    "./tileset": {
      "types": "./dist/tileset/index.d.ts",
      "import": "./dist/tileset/index.js"
    },
    "./marker": {
      "types": "./dist/marker/index.d.ts",
      "import": "./dist/marker/index.js"
    },
    "./track": {
      "types": "./dist/track/index.d.ts",
      "import": "./dist/track/index.js"
    },
    "./terrain": {
      "import": "./dist/terrain/index.js",
      "types": "./dist/terrain/index.d.ts"
    },
    "./primitive": {
      "import": "./dist/primitive/index.js",
      "types": "./dist/primitive/index.d.ts"
    },
    "./material": {
      "import": "./dist/material/index.js",
      "types": "./dist/material/index.d.ts"
    },
    "./data-source": {
      "import": "./dist/data-source/index.js",
      "types": "./dist/data-source/index.d.ts"
    },
    "./transform": {
      "import": "./dist/transform/index.js",
      "types": "./dist/transform/index.d.ts"
    },
    "./scene": {
      "import": "./dist/scene/index.js",
      "types": "./dist/scene/index.d.ts"
    },
    "./snapshot": {
      "import": "./dist/snapshot/index.js",
      "types": "./dist/snapshot/index.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build-library.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:docs": "playwright test --config playwright.docs.config.mjs",
    "docs:dev": "node scripts/build-docs.mjs --dev",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:preview": "vitepress preview docs",
    "example:dev": "pnpm build && vite --config examples/basic/vite.config.mjs",
    "example:build": "pnpm build && vite build --config examples/basic/vite.config.mjs",
    "example:preview": "vite preview --config examples/basic/vite.config.mjs",
    "package:check": "pnpm build && node scripts/verify-package.mjs",
    "package:consumer": "pnpm package:check && node scripts/verify-consumer.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm docs:build && pnpm example:build && node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "cesium": "^1.145.0",
    "typescript": "^5.9.3",
    "vite": "5.4.21",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.4.1"
}
