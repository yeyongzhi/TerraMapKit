{
  "name": "terra-map-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A modular TypeScript toolkit for CesiumJS",
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./layer": {
      "types": "./dist/layer/index.d.ts",
      "import": "./dist/layer/index.js"
    },
    "./mask": {
      "types": "./dist/mask/index.d.ts",
      "import": "./dist/mask/index.js"
    },
    "./coordinate": {
      "types": "./dist/coordinate/index.d.ts",
      "import": "./dist/coordinate/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "pnpm typecheck && pnpm build && pnpm docs:build"
  },
  "peerDependencies": {
    "cesium": "^1.145.0"
  },
  "devDependencies": {
    "cesium": "^1.145.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.4.1"
}
